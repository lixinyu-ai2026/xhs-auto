# 小红书MCP工具包环境变量配置

# Chrome浏览器路径
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ChromeDriver路径（可选，为空则使用系统PATH）
WEBDRIVER_CHROME_DRIVER=C:\Program Files\Google\Chrome\Application\chromedriver.exe

# MCP服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Cookies文件路径
COOKIES_FILE=xhs_cookies.json

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=xhs_toolkit.log

# 浏览器选项
DISABLE_IMAGES=false
DEBUG_MODE=false
# 无头浏览器模式（true=启用无头模式，false=显示浏览器界面）
HEADLESS=false

# 超时设置（秒）
TIMEOUT=30

# ==================== 数据存储配置(暂不支持) ====================
# 是否启用PostgreSQL数据库存储（false=仅使用CSV存储，true=同时使用PostgreSQL）
# ENABLE_DATABASE=false

# PostgreSQL数据库连接配置
# DATABASE_URL=postgresql://username:password@localhost:5432/xhs_toolkit
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=xhs_toolkit
# DATABASE_USER=username
# DATABASE_PASSWORD=password

# CSV数据存储路径（本地存储始终启用）
DATA_STORAGE_PATH=data

# ==================== 定时任务配置 ====================
# 是否启用自动数据采集
ENABLE_AUTO_COLLECTION=true

# 程序启动时是否立即执行一次数据采集
RUN_ON_STARTUP=true

# 定时采集计划（cron表达式格式：秒 分 时 日 月 星期）
# 默认：每天凌晨1点执行数据采集
COLLECTION_SCHEDULE=0 1 * * *

# 采集任务配置
# 是否采集仪表板数据
COLLECT_DASHBOARD=true
# 是否采集内容分析数据  
COLLECT_CONTENT_ANALYSIS=true
# 是否采集粉丝数据
COLLECT_FANS=true

# 定时任务时区设置
TIMEZONE=Asia/Shanghai

# 基础配置 - 公共配置
NOTES_COUNT=3               # 要生成的笔记数量
IMAGES_PER_NOTE=3           # 每篇笔记的图片数量
CONTENT_THEME=旅行         # 内容主题
STYLE=清新文艺             # 内容风格
TARGET_AUDIENCE=年轻人     # 目标受众

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat    # 可选: deepseek-chat或deepseek-coder

# Kimi API 配置
KIMI_API_KEY=your_kimi_api_key_here

# 自动发布配置
AUTO_PUBLISH=False         # 是否自动发布到小红书
PUBLISH_DELAY=10          # 生成后等待多少秒发布
PUBLISH_INTERVAL=60       # 两篇笔记之间的发布间隔时间(秒)

# Playwright 浏览器路径配置（Windows用户可能需要设置）
# PLAYWRIGHT_BROWSERS_PATH=C:\\path\\to\\browsers
